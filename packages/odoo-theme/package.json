{
  "name": "odoo-color-theme",
  "displayName": "Odoo Color Theme",
  "description": "Color theme for Odoo developers inspired by the Odoo brand colors (purple #714B67 and teal #017E84). Includes Dark, Light, Midnight and Community variants with Python, XML/QWeb and OWL highlighting.",
  "version": "0.1.0",
  "publisher": "MrKaos",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrKaos72/vscode-odoo-color-theme.git",
    "directory": "packages/odoo-theme"
  },
  "bugs": {
    "url": "https://github.com/MrKaos72/vscode-odoo-color-theme/issues"
  },
  "homepage": "https://github.com/MrKaos72/vscode-odoo-color-theme/tree/main/packages/odoo-theme#readme",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "odoo",
    "theme",
    "dark",
    "light",
    "python",
    "xml"
  ],
  "galleryBanner": {
    "color": "#714B67",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "Odoo Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/odoo-dark-color-theme.json"
      },
      {
        "label": "Odoo Light",
        "uiTheme": "vs",
        "path": "./themes/odoo-light-color-theme.json"
      },
      {
        "label": "Odoo Midnight",
        "uiTheme": "vs-dark",
        "path": "./themes/odoo-midnight-color-theme.json"
      },
      {
        "label": "Odoo Community",
        "uiTheme": "vs-dark",
        "path": "./themes/odoo-community-color-theme.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "source.python.odoo-injection",
        "path": "./syntaxes/odoo-python.injection.json",
        "injectTo": [
          "source.python"
        ]
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build-themes.js",
    "build:icon": "node scripts/make-icon.js",
    "check": "node scripts/check-contrast.js && node scripts/validate-themes.js",
    "test:grammar": "node scripts/test-grammar.js",
    "test": "npm run build && npm run check && npm run test:grammar",
    "package": "npm run build && npm run check && vsce package --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0",
    "ovsx": "^0.10.5",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  }
}
