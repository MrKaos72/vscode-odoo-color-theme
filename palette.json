    "charts.lines": "$fgMuted",
    "charts.red": "$error",
    "charts.yellow": "$warning",
    "charts.blue": "$info",
    "charts.green": "$success",
    "charts.orange": "$orm",
    "charts.purple": "$keyword",

    "symbolIcon.classForeground": "$class",
    "symbolIcon.functionForeground": "$function",
    "symbolIcon.methodForeground": "$function",
    "symbolIcon.variableForeground": "$type",
    "symbolIcon.fieldForeground": "$orm",
    "symbolIcon.propertyForeground": "$orm",
    "symbolIcon.constantForeground": "$constant",
    "symbolIcon.keywordForeground": "$keyword",
    "symbolIcon.moduleForeground": "$decorator",
    "testing.iconPassed": "$success",
    "testing.iconFailed": "$error"
  },

  "syntax": {
    "comment": { "color": "$comment", "fontStyle": "italic" },
    "keyword": { "color": "$keyword" },
    "operator": { "color": "$operator" },
    "class": { "color": "$class" },
    "function": { "color": "$function" },
    "string": { "color": "$string" },
    "stringEscape": { "color": "$decorator" },
    "regex": { "color": "$orm" },
    "constant": { "color": "$constant" },
    "orm": { "color": "$orm" },
    "decorator": { "color": "$decorator" },
    "type": { "color": "$type" },
    "self": { "color": "$self", "fontStyle": "italic" },
    "tag": { "color": "$keyword" },
    "tagPunctuation": { "color": "$operator" },
    "attribute": { "color": "$orm" },
    "cssClass": { "color": "$class" },
    "cssProperty": { "color": "$type" },
    "cssVariable": { "color": "$self" },
    "markupHeading": { "color": "$keyword", "fontStyle": "bold" },
    "markupBold": { "fontStyle": "bold" },
    "markupItalic": { "fontStyle": "italic" },
    "markupLink": { "color": "$function" },
    "markupCode": { "color": "$string" },
    "markupQuote": { "color": "$comment", "fontStyle": "italic" },
    "markupInserted": { "color": "$gitAdded" },
    "markupDeleted": { "color": "$gitDeleted" },
    "markupChanged": { "color": "$gitModified" },
    "invalid": { "color": "$error" },
    "csv1": { "color": "$editorFg" },
    "csv2": { "color": "$keyword" },
    "csv3": { "color": "$class" },
    "csv4": { "color": "$string" },
    "csv5": { "color": "$orm" },
    "csv6": { "color": "$decorator" },
    "csv7": { "color": "$type" },
    "csv8": { "color": "$self" },
    "csv9": { "color": "$function" },
    "csv10": { "color": "$operator" }
  }
}
